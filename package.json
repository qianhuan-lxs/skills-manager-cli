{
  "name": "skm-cli",
  "version": "0.1.0",
  "description": "AI coding agent skill lifecycle management CLI — discover, scan, diagnose, generate, evolve",
  "type": "module",
  "bin": {
    "skm": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "claude-code",
    "skill",
    "mcp",
    "cli",
    "agent",
    "security",
    "evolution",
    "cursor",
    "codex",
    "skill-manager"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qianhuan-lxs/skills-manager-cli.git"
  },
  "homepage": "https://github.com/qianhuan-lxs/skills-manager-cli#readme",
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "openai": "^6.37.0",
    "zod": "^4.4.3"
  }
}
